# bench.env — optional configuration for the wirewatch benchmark runner.
# Copy this file to bench.env and uncomment/edit the lines you need.
# bench.env is gitignored.

# Number of cuttlefish devices to boot (default 1).
# DEVICE_COUNT=1

# LiteLLM proxy credentials (required for agent runs).
# LITELLM_BASE_URL=
# LITELLM_MASTER_KEY=
# LITELLM_USER_ID=
# LITELLM_TEAM_ID=

# Optional: SSH target for an x86_64 host that runs cuttlefish-x86.
# When set, x86 APKs dispatch to this host instead of being skipped.
# The host must have: docker, /dev/kvm, the repo cloned at ~/wirellm-bench,
# and the x86 AOSP images in infra/x86/. Run `./bench setup-x86` to
# bootstrap it automatically.
# X86_SSH=user@x86-host.tailscale.net

# Number of x86 devices on the remote host (default 1).
# X86_DEVICE_COUNT=1
